          "givenLabel": "給定算式：",
          "given": "\\dfrac{1}{2}+\\dfrac{1}{3}",
          "steps": [
            {
              "title": "找出公分母（通分）",
              "reason": "分母 2 與 3 的最小公倍數是 6，把兩分數都改成分母為 6：",
              "calcs": [
                "\\dfrac{1}{2}=\\dfrac{1\\times 3}{2\\times 3}=\\dfrac{3}{6}",
                "\\dfrac{1}{3}=\\dfrac{1\\times 2}{3\\times 2}=\\dfrac{2}{6}"
              ]
            },
            {
              "title": "分子相加",
              "reason": "分母相同後，分子直接相加：",
              "calcs": [
                "\\dfrac{3}{6}+\\dfrac{2}{6}=\\dfrac{5}{6}"
